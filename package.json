{
  "name": "pantechnosyni",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Public interdisciplinary synthesis system connecting creative practice, technology, science, and human experience.",
  "scripts": {
    "test": "node --test",
    "check:foundation": "node scripts/check-foundation.mjs",
    "atlas": "node scripts/pantechnosyni-atlas.mjs summary",
    "atlas:json": "node scripts/pantechnosyni-atlas.mjs json",
    "atlas:disciplines": "node scripts/pantechnosyni-atlas.mjs disciplines",
    "build:web-data": "node scripts/build-atlas-web-data.mjs",
    "check:web-data": "node scripts/build-atlas-web-data.mjs --check",
    "check:atlas-web": "node scripts/check-atlas-web.mjs",
    "check": "npm test && npm run check:foundation && npm run check:web-data && npm run check:atlas-web"
  },
  "engines": {
    "node": ">=22"
  },
